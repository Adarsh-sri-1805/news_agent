# Environment Configuration for Local News Intelligence Agent
# Copy this file to .env and adjust values as needed. No secrets required for local inference.

# LLM Provider Configuration ('auto', 'gemini', or 'ollama')
# 'auto' automatically uses Gemini if GEMINI_API_KEY is present, otherwise falls back to local Ollama
LLM_PROVIDER=auto

# Google Gemini API Settings (Free Tier - fast cloud inference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama local inference settings (Zero cost local CPU/GPU execution)
OLLAMA_BASE_URL=http://localhost:11434
# Recommended 3B-parameter model suited for 16GB RAM CPU execution:
OLLAMA_MODEL=llama3.2:3b
# Connection and request timeout in seconds (CPU inference may require longer timeouts):
OLLAMA_TIMEOUT_SECONDS=90.0
# How long the model stays loaded in memory between requests (e.g., 5m, 10m, -1 for indefinitely)
OLLAMA_KEEP_ALIVE=5m

# Ingestion Pipeline Settings
INGESTION_LOOKBACK_HOURS=24
INGESTION_TIMEOUT_SECONDS=15.0
INGESTION_MAX_RETRIES=2
INGESTION_USER_AGENT=LocalNewsIntelligenceAgent/1.0 (+https://github.com/local-news-intelligence)

# Optional GDELT 2.0 Discovery
GDELT_ENABLED=false
GDELT_QUERY=local government OR municipal council
GDELT_MAX_RECORDS=25

# Application runtime settings
APP_ENV=development
LOG_LEVEL=INFO
